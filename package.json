{
  "name": "job-hopping-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "astro preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:sample": "node scripts/seed.mjs data/sample.json --local",
    "db:backup": "wrangler d1 export DB --remote --output backup-$(date +%Y%m%d-%H%M%S).sql",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "astro": "7.4.2",
    "jose": "6.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  }
}
