// Copy to wrangler.jsonc (git-ignored) and fill in the values printed by
// `terraform -chdir=infra output`.
{
  "name": "job-hopping-dashboard",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-20",
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  // Only reachable through the Access-protected custom domain
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "<HOSTNAME>", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "job-hopping",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // e.g. myteam.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "<TEAM>.cloudflareaccess.com",
    // Access application AUD tag (terraform output access_aud)
    "ACCESS_AUD": "<ACCESS_AUD>"
  }
}
